generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── USUÁRIOS ─────────────────────────────────────────────────────────────────
model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CLIENT)
  phone     String?
  document  String?
  birthDate DateTime?
  group     String?   @default("Regular")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reservations Reservation[]
  checkins     Checkin[]

  @@map("users")
}

enum Role {
  ADMIN
  OPERATOR
  CLIENT
}

// ─── SALAS ────────────────────────────────────────────────────────────────────
model Room {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  type        String
  capacity    Int
  width       Float?
  height      Float?
  location    String?
  active      Boolean  @default(true)
  layout      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sectors Sector[]
  events  Event[]

  @@map("rooms")
}

// ─── SETORES ──────────────────────────────────────────────────────────────────
model Sector {
  id       Int    @id @default(autoincrement())
  name     String
  color    String @default("#705EBD")
  capacity Int
  roomId   Int
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  seats Seat[]

  @@map("sectors")
}

// ─── ASSENTOS ─────────────────────────────────────────────────────────────────
model Seat {
  id       Int        @id @default(autoincrement())
  label    String
  row      String
  number   Int
  type     SeatType   @default(STANDARD)
  status   SeatStatus @default(AVAILABLE)
  x        Float?
  y        Float?
  sectorId Int
  sector   Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  reservationItems ReservationItem[]

  @@map("seats")
}

enum SeatType {
  STANDARD
  VIP
  PREMIUM
  PCD
  DBOX
  GUIDE_DOG
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  BLOCKED
  RESERVED
}

// ─── EVENTOS ──────────────────────────────────────────────────────────────────
model Event {
  id          Int         @id @default(autoincrement())
  name        String
  description String?     @db.Text
  type        String
  date        DateTime
  endDate     DateTime?
  roomId      Int
  room        Room        @relation(fields: [roomId], references: [id])
  status      EventStatus @default(SCHEDULED)
  highlight   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tickets      Ticket[]
  reservations Reservation[]
  waitlist     Waitlist[]
  checkins     Checkin[]

  @@map("events")
}

enum EventStatus {
  SCHEDULED
  ONGOING
  FINISHED
  CANCELLED
}

// ─── INGRESSOS ────────────────────────────────────────────────────────────────
model Ticket {
  id          Int     @id @default(autoincrement())
  eventId     Int
  event       Event   @relation(fields: [eventId], references: [id])
  type        String
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  sold        Int     @default(0)
  description String?

  reservationItems ReservationItem[]

  @@map("tickets")
}

// ─── RESERVAS ─────────────────────────────────────────────────────────────────
model Reservation {
  id        Int               @id @default(autoincrement())
  code      String            @unique
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  eventId   Int
  event     Event             @relation(fields: [eventId], references: [id])
  status    ReservationStatus @default(PENDING)
  total     Decimal           @db.Decimal(10, 2)
  payment   String?
  paidAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  items    ReservationItem[]
  checkins Checkin[]

  @@map("reservations")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

// ─── ITENS DA RESERVA ─────────────────────────────────────────────────────────
model ReservationItem {
  id            Int         @id @default(autoincrement())
  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketId      Int
  ticket        Ticket      @relation(fields: [ticketId], references: [id])
  seatId        Int?
  seat          Seat?       @relation(fields: [seatId], references: [id])
  price         Decimal     @db.Decimal(10, 2)
  quantity      Int         @default(1)

  @@map("reservation_items")
}

// ─── CHECK-IN ─────────────────────────────────────────────────────────────────
model Checkin {
  id            Int         @id @default(autoincrement())
  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
  eventId       Int
  event         Event       @relation(fields: [eventId], references: [id])
  checkedAt     DateTime    @default(now())
  method        String      @default("QR_CODE")

  @@map("checkins")
}

// ─── LISTA DE ESPERA ──────────────────────────────────────────────────────────
model Waitlist {
  id         Int            @id @default(autoincrement())
  userId     Int
  eventId    Int
  event      Event          @relation(fields: [eventId], references: [id])
  ticketType String
  position   Int
  status     WaitlistStatus @default(WAITING)
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@map("waitlist")
}

enum WaitlistStatus {
  WAITING
  CALLED
  CONVERTED
  EXPIRED
}

// ─── TRANSAÇÕES FINANCEIRAS ───────────────────────────────────────────────────
model Transaction {
  id          Int             @id @default(autoincrement())
  description String
  type        TransactionType
  category    String
  method      String?
  amount      Decimal         @db.Decimal(10, 2)
  status      String          @default("COMPLETED")
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}
